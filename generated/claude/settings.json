{
  "permissions": {
    "allow": [
      "Read(//Users/you/projects/**)",
      "Read(//tmp/**)",
      "Read(//private/tmp/**)",
      "Read(//private/var/folders/**)",
      "Edit(//Users/you/projects/**)",
      "Edit(//tmp/**)",
      "Edit(//private/tmp/**)",
      "Edit(//private/var/folders/**)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(roborepo agent-run:*)",
      "Bash(roborepo doctor:*)",
      "Bash(roborepo telemetry:*)",
      "Bash(roborepo git:*)",
      "Bash(roborepo index:*)",
      "Bash(roborepo localhoster:*)",
      "Bash(roborepo version:*)",
      "Bash(roborepo plans:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm run test:*)",
      "Bash(pytest:*)",
      "Bash(uv run pytest:*)",
      "Bash(go test:*)",
      "Bash(cargo test:*)",
      "Bash(./scripts/doctor.sh:*)",
      "Bash(./scripts/verify-install.sh:*)",
      "Bash(./scripts/install/main.sh --dry-run:*)",
      "Bash(npm run skills:compile:*)",
      "Bash(npm run skills:validate:*)",
      "Bash(npm install:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:preview:*)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run check:*)",
      "Bash(npx tsc:*)",
      "Bash(npx next lint:*)",
      "Bash(npx eslint:*)",
      "Bash(npx jest:*)",
      "Bash(git status:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git checkout main:*)",
      "Bash(git switch main:*)",
      "Bash(git checkout -B main:*)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(git rm:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(roborepo update:*)",
      "Bash(roborepo maintenance:*)",
      "Bash(roborepo mcp:*)",
      "Bash(roborepo package:*)",
      "Bash(roborepo skill:*)",
      "Bash(roborepo config:*)",
      "Bash(roborepo harness:*)",
      "Bash(roborepo apply:*)",
      "Bash(roborepo permissions:*)",
      "Bash(roborepo rules:*)",
      "Bash(roborepo setup:*)",
      "Bash(roborepo workspace:*)",
      "Bash(roborepo presets:*)",
      "Bash(roborepo bundle:*)",
      "Bash(roborepo experimental:*)",
      "Bash(roborepo onboard-intro:*)",
      "Bash(roborepo init:*)",
      "Bash(roborepo dev:*)",
      "Bash(roborepo library:*)",
      "Bash(roborepo uninstall:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "count=0; for d in \"${HOME}/.codex/skills\"/*/; do name=\"$(basename \"${d%/}\")\"; case \"${name}\" in .*) continue;; esac; [ -L \"${d%/}\" ] || count=$((count+1)); done; for d in \"${HOME}/.claude/skills\"/*/; do name=\"$(basename \"${d%/}\")\"; case \"${name}\" in .*) continue;; esac; [ -L \"${d%/}\" ] || count=$((count+1)); done; [ \"${count}\" -gt 0 ] && echo \"{\\\"systemMessage\\\": \\\"unmanaged skills: ${count} — run 'roborepo skill adopt <name>' to version-control\\\"}\" || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/minimize-bash-output.mjs\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/provider/repo-write-scope.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/roborepo-write-guard.mjs\""
          }
        ]
      }
    ]
  },
  "alwaysThinkingEnabled": false,
  "awaySummaryEnabled": false
}
