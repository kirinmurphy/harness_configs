{
  "behaviors": [
    {
      "id": "write-files",
      "label": "Write files",
      "description": "Create and edit files (Write, Edit tools).",
      "kind": "tools",
      "tools": ["Write", "Edit"],
      "bucket": "allow"
    },
    {
      "id": "delete-files",
      "label": "Delete files",
      "description": "Remove files from disk (rm, git rm).",
      "kind": "commands",
      "commands": [["rm"], ["git", "rm"]],
      "bucket": "ask"
    },
    {
      "id": "go-online",
      "label": "Go online",
      "description": "Sandbox network access. Codex-only — Claude does not sandbox network egress.",
      "kind": "network",
      "codexOnly": true,
      "bucket": "deny"
    },
    {
      "id": "commit-code",
      "label": "Commit code",
      "description": "Stage and commit changes locally (git add, git commit).",
      "kind": "commands",
      "commands": [["git", "add"], ["git", "commit"]],
      "bucket": "allow"
    },
    {
      "id": "push-pull-prs",
      "label": "Push / pull / PRs",
      "description": "Move code to or from a remote (git push, git pull).",
      "kind": "commands",
      "commands": [["git", "push"], ["git", "pull"]],
      "bucket": "deny"
    }
  ],
  "tools": {
    "read": ["Read"]
  },
  "mcp": {},
  "commands": {
    "allow": [
      ["npm", "test"],
      ["npm", "run", "test"],
      ["pnpm", "test"],
      ["pnpm", "run", "test"],
      ["pytest"],
      ["uv", "run", "pytest"],
      ["go", "test"],
      ["cargo", "test"],
      ["./scripts/doctor.sh"],
      ["./scripts/verify-install.sh"],
      ["./scripts/install/main.sh", "--dry-run"],
      ["roborepo", "doctor"],
      ["roborepo", "verify"],
      ["roborepo", "update", "--dry-run"],
      ["npm", "run", "skills:compile"],
      ["npm", "run", "skills:validate"],
      ["npm", "install"],
      ["npm", "run", "lint"],
      ["npm", "run", "build:preview"],
      ["npm", "run", "build"],
      ["npm", "run", "dev"],
      ["npm", "run", "check"],
      ["npx", "tsc"],
      ["npx", "next", "lint"],
      ["npx", "eslint"],
      ["npx", "jest"],
      ["git", "status"],
      ["git", "log"]
    ]
  }
}
