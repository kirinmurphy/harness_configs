{
  "path": ["git", "remote-sync-check"],
  "kind": "command",
  "title": "Remote sync check",
  "description": "Check local branches against their configured remotes",
  "order": 20,
  "usage": "roborepo git remote-sync-check [path] [--menu] [--json|--markdown|--table|--compact] [--include-clean] [--max-depth <n>]",
  "arguments": [{ "name": "path", "required": true, "interactive": { "prompt": "Folder to scan" } }],
  "interactiveArgs": ["--menu"],
  "interactiveStdio": true,
  "onComplete": "returnToSubmenu",
  "execution": {
    "adapter": "module",
    "module": "scripts/maintenance/git-remote-sync.mjs",
    "export": "remoteSyncCheck"
  }
}
