{
  "name": "@kirin/roborepo",
  "version": "0.1.0-beta.0",
  "description": "Portable Claude/Codex harness configuration manager.",
  "type": "module",
  "bin": {
    "roborepo": "bin/roborepo"
  },
  "files": [
    "bin/",
    "globals/",
    "generated/",
    "manifests/",
    "scripts/build/",
    "scripts/cli/",
    "scripts/install/",
    "scripts/lib/",
    "portal/",
    "scripts/doctor.sh",
    "scripts/verify-install.sh",
    "shell/",
    "README.md",
    "docs/reference/services/roborepo.md",
    "docs/reference/services/localhoster.md",
    "docs/reference/services/telemetry.md",
    "docs/reference/services/architecture.md",
    "docs/guides/plan-docs.md",
    "docs/reference/services/plans-portal.md",
    "docs/reference/internal/config-collision-handling.md"
  ],
  "scripts": {
    "test": "scripts/test/test-roborepo.sh --quiet",
    "test:context-cost": "node scripts/test/context-cost-check.mjs",
    "test:localhoster": "node scripts/test/localhoster-check.mjs",
    "test:repositories": "node scripts/test/repositories-check.mjs",
    "test:repositories-service": "node scripts/test/repositories-service-check.mjs",
    "test:repositories-api": "node scripts/test/repositories-api-check.mjs",
    "test:packages": "node scripts/test/package-catalog-check.mjs",
    "test:package-lifecycle": "node scripts/test/package-lifecycle-check.mjs",
    "test:package-default-enabled": "node scripts/test/package-default-enabled-check.mjs",
    "test:usage-statusline": "node scripts/test/usage-statusline-check.mjs",
    "test:plans": "node scripts/test/plan-docs-check.mjs",
    "test:plans-repair": "node scripts/test/plan-docs-repair-check.mjs",
    "test:plans-portal-state": "node scripts/test/plans-portal-state-check.mjs",
    "test:telemetry": "node scripts/test/telemetry-correctness-check.mjs",
    "test:telemetry-schemas": "node scripts/test/telemetry-schemas-check.mjs",
    "test:telemetry-marker-cli": "node scripts/test/telemetry-marker-cli-check.mjs",
    "test:telemetry-classify": "node scripts/test/telemetry-classify-check.mjs",
    "test:telemetry-capture-v3": "node scripts/test/telemetry-capture-v3-check.mjs",
    "test:telemetry-phase-infer": "node scripts/test/telemetry-phase-infer-check.mjs",
    "test:telemetry-task-infer": "node scripts/test/telemetry-task-infer-check.mjs",
    "test:telemetry-phase4-integration": "node scripts/test/telemetry-phase4-integration-check.mjs",
    "test:telemetry-metrics": "node scripts/test/telemetry-metrics-check.mjs",
    "test:telemetry-cohort": "node scripts/test/telemetry-cohort-check.mjs",
    "test:telemetry-compare": "node scripts/test/telemetry-compare-check.mjs",
    "test:telemetry-policy": "node scripts/test/telemetry-policy-check.mjs",
    "test:telemetry-portal-state": "node scripts/test/telemetry-portal-state-check.mjs",
    "test:markdown-render": "node scripts/test/markdown-render-check.mjs",
    "pack:dry-run": "npm pack --dry-run",
    "pack:smoke": "npm pack"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
