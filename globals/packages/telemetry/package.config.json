{
  "schemaVersion": 1,
  "id": "telemetry",
  "label": "Token Telemetry",
  "description": "Capture and visualize token usage across harnesses. The web portal is started separately with roborepo web.",
  "lifecycle": "optional",
  "presentation": {
    "category": "monitoring",
    "order": 10
  },
  "resources": [
    {
      "type": "service",
      "id": "telemetry"
    },
    {
      "type": "hooks",
      "source": "hooks-claude.json",
      "harness": "claude"
    },
    {
      "type": "hooks",
      "source": "hooks-codex.json",
      "harness": "codex"
    },
    {
      "type": "skill",
      "id": "telemetry-marker",
      "source": "skills/telemetry-marker",
      "invocation": "manual",
      "risk": "low",
      "entrypoints": [
        {
          "type": "slash-command",
          "name": "telemetry-marker",
          "description": "Record a telemetry marker or manage an experiment.",
          "harnesses": ["claude", "codex", "gemini"]
        }
      ]
    }
  ]
}
