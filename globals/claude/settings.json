{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "mcp__jcodemunch__resolve_repo",
      "mcp__jcodemunch__search_symbols",
      "mcp__jcodemunch__get_file_outline",
      "mcp__jcodemunch__find_references",
      "mcp__jcodemunch__get_context_bundle",
      "mcp__jcodemunch__search_text",
      "mcp__jcodemunch__index_repo",
      "mcp__jcodemunch__list_repos",
      "mcp__jcodemunch__get_symbol_context",
      "Bash(npx playwright test:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm run test:*)",
      "Bash(pytest:*)",
      "Bash(uv run pytest:*)",
      "Bash(go test:*)",
      "Bash(cargo test:*)",
      "Bash(./scripts/doctor.sh:*)",
      "Bash(./scripts/verify-install.sh:*)",
      "Bash(./scripts/install/main.sh --dry-run:*)",
      "Bash(roborepo doctor:*)",
      "Bash(roborepo verify:*)",
      "Bash(roborepo update --dry-run:*)",
      "Bash(npm run skills:compile:*)",
      "Bash(npm run skills:validate:*)",
      "Bash(npm install:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:preview:*)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run demo:start:*)",
      "Bash(npm run audit:run:blocking:*)",
      "Bash(npm run audit:run:*)",
      "Bash(npm run check:*)",
      "Bash(npx tsc:*)",
      "Bash(npx next lint:*)",
      "Bash(npx eslint:*)",
      "Bash(npx jest:*)",
      "Bash(/bin/zsh -lc npm run check > /tmp/sembrando-astro-check.log 2>&1:*)",
      "Bash(npx convex codegen:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(docker volume ls:*)",
      "Bash(docker system df:*)",
      "Bash(docker volume inspect:*)",
      "Bash(docker stats --no-stream:*)",
      "Bash(docker builder prune -f:*)",
      "Bash(supabase start:*)",
      "Bash(docker events:*)",
      "Bash(pgrep:*)",
      "Bash(kill:*)",
      "Bash(scripts/test/test-install-collisions.sh:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git rm:*)",
      "Bash(rm:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "dir=\"$(pwd)\"; hash=\"$(echo -n \"$dir\" | md5sum 2>/dev/null | cut -c1-32 || echo -n \"$dir\" | md5)\"; pidfile=\"/tmp/jcmwatch-${hash}.pid\"; if [ -f \"$pidfile\" ]; then pid=$(awk '{print $1}' \"$pidfile\"); stored_start=$(cut -d' ' -f2- \"$pidfile\"); actual_start=$(ps -p \"$pid\" -o lstart= 2>/dev/null | tr -s ' ' || ps -p \"$pid\" -o start= 2>/dev/null | tr -s ' ' || echo ''); if [ \"$stored_start\" = \"$actual_start\" ]; then echo '{\"systemMessage\": \"jcodemunch is available and the code watcher is running — index is kept current automatically. Use resolve_repo, search_symbols, get_file_outline, find_references, get_context_bundle for code exploration.\"}'; else echo '{\"systemMessage\": \"jcodemunch is available. Use resolve_repo, search_symbols, get_file_outline, find_references, get_context_bundle — NOT Grep/Read — for code exploration. the code watcher is NOT running; run `roborepo index code` if the index may be stale.\"}'; fi; else echo '{\"systemMessage\": \"jcodemunch is available. Use resolve_repo, search_symbols, get_file_outline, find_references, get_context_bundle — NOT Grep/Read — for code exploration. the code watcher is NOT running; run `roborepo index code` if the index may be stale.\"}'; fi"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "roborepo telemetry capture --harness claude --event SessionStart"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "count=0; for d in \"${HOME}/.codex/skills\"/*/; do name=\"$(basename \"${d%/}\")\"; case \"${name}\" in .*) continue;; esac; [ -L \"${d%/}\" ] || count=$((count+1)); done; for d in \"${HOME}/.claude/skills\"/*/; do name=\"$(basename \"${d%/}\")\"; case \"${name}\" in .*) continue;; esac; [ -L \"${d%/}\" ] || count=$((count+1)); done; [ \"${count}\" -gt 0 ] && echo \"{\\\"systemMessage\\\": \\\"unmanaged skills: ${count} — run 'roborepo skill adopt <name>' to version-control\\\"}\" || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "roborepo telemetry capture --harness claude --event PreToolUse"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/block-source-exploration.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/minimize-bash-output.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/capture-dense-bash.mjs\""
          }
        ]
      },
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"continue\": false, \"stopReason\": \"Grep and Glob are blocked. Use jcodemunch tools instead: search_symbols, get_file_outline, find_references, or get_context_bundle.\"}'"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/roborepo-write-guard.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "roborepo telemetry capture --harness claude --event PostToolUse"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "roborepo telemetry capture --harness claude --event UserPromptSubmit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "roborepo telemetry capture --harness claude --event Stop"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "alwaysThinkingEnabled": false,
  "awaySummaryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "model": "opus"
}
