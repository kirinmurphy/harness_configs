{
  "tests": [
    {
      "skill": "case-study",
      "match": [
        "write a case study about the root config drift decision",
        "/case-study root config architecture"
      ],
      "nearMiss": [
        "write a PR description for the root config change",
        "summarize this implementation note"
      ],
      "triggerPhrases": ["case study", "/case-study"],
      "skipPhrases": ["PR descriptions", "implementation notes"]
    },
    {
      "skill": "frontend-design",
      "match": [
        "building a polished interactive UI",
        "substantially redesigning this settings page"
      ],
      "nearMiss": [
        "fix this TypeScript helper",
        "make a small copy tweak in the button label"
      ],
      "triggerPhrases": ["frontend interfaces", "web components", "interactive UI", "substantially redesigning"],
      "skipPhrases": ["backend-only", "small copy/style tweaks", "ordinary React/TypeScript fixes"]
    },
    {
      "skill": "plan-docs",
      "match": [
        "create an implementation plan for package reconciliation",
        "sync this plan with what we just changed",
        "/plan-docs validate docs/plans/backlog/example.md"
      ],
      "nearMiss": [
        "write a quick PR summary",
        "give me a brief answer about this function",
        "implement this ordinary code change"
      ],
      "triggerPhrases": ["/plan-docs", "implementation plan", "sync this plan", "review whether a plan is complete"],
      "skipPhrases": ["brief answers", "PR descriptions", "ordinary implementation"]
    },
    {
      "skill": "tighten",
      "match": [
        "/tighten this module",
        "clean this up against our patterns"
      ],
      "nearMiss": [
        "make this ordinary edit",
        "review this code for bugs"
      ],
      "triggerPhrases": ["/tighten", "tighten", "clean this up against our patterns"],
      "skipPhrases": ["ordinary edits", "mere presence of code"]
    }
  ]
}
