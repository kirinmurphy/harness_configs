{
  "name": "@kirin/roborepo",
  "version": "0.1.0-beta.0",
  "description": "Portable Claude/Codex harness configuration manager.",
  "type": "module",
  "bin": {
    "roborepo": "bin/roborepo"
  },
  "files": [
    "bin/",
    "globals/",
    "generated/",
    "manifests/",
    "scripts/build/",
    "scripts/cli/",
    "scripts/install/",
    "scripts/lib/",
    "portal/",
    "scripts/doctor.sh",
    "scripts/verify-install.sh",
    "shell/",
    "README.md",
    "docs/reference/services/roborepo.md",
    "docs/reference/services/localhoster.md",
    "docs/reference/services/architecture.md",
    "docs/guides/plan-docs.md",
    "docs/reference/services/plans-portal.md",
    "docs/reference/internal/config-collision-handling.md"
  ],
  "scripts": {
    "test": "scripts/test/test-roborepo.sh --quiet",
    "test:localhoster": "node scripts/test/localhoster-check.mjs",
    "test:packages": "node scripts/test/package-catalog-check.mjs",
    "test:plans": "node scripts/test/plan-docs-check.mjs",
    "pack:dry-run": "npm pack --dry-run",
    "pack:smoke": "npm pack"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": false
}
